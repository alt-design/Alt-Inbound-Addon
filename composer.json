{
    "name": "alt-design/alt-inbound",
    "description": "Alt Inbound addon, adds IP blocking to your site",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "AltDesign\\AltInbound\\": "src"
        }
    },
    "require": {
        "php": "^8.1",
        "statamic/cms": "^6.0"
    },
    "extra": {
        "statamic": {
            "name": "Alt Inbound",
            "description": "Alt Inbound addon"
        },
        "laravel": {
            "providers": [
                "AltDesign\\AltInbound\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.4",
        "pestphp/pest-plugin-laravel": "^4.1",
        "orchestra/testbench": "^11.1"
    },
    "autoload-dev": {
        "psr-4": {
            "AltDesign\\AltInbound\\Tests\\": "tests"
        }
    }
}
